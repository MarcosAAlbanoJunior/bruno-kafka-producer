# Copie este arquivo para ".env" (ja esta no .gitignore) e preencha os valores reais.
# Nunca commite o arquivo ".env" - so o ".env.sample" (sem valores) fica no Git.
#
# Truststore e Keystore sao OPCIONAIS (dependem do broker exigir TLS/mTLS ou nao),
# mas quando o caminho for informado no environment (kafkaTruststorePath /
# kafkaKeystorePath), a respectiva senha abaixo passa a ser obrigatoria.

KAFKA_TRUSTSTORE_PASSWORD=
KAFKA_KEYSTORE_PASSWORD=

# Só necessário se kafkaSaslEnabled: true no environment
KAFKA_SASL_PASSWORD=

# Só necessário se kafkaSchemaRegistryEnabled: true E kafkaSchemaRegistryUsername
# estiver preenchido no environment (registries sem auth não precisam disso)
KAFKA_SCHEMA_REGISTRY_PASSWORD=
