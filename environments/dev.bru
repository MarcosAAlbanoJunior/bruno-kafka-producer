vars {
  ~comentario: Cluster de desenvolvimento. ENVIRONMENT = CLUSTER: topico e payload ficam no request.
  ~comentario2: Qualquer variavel aceita o sufixo _<kafkaApp> para variar por aplicacao.
  kafkaBrokers: broker1.dev.interno:9093,broker2.dev.interno:9093
  kafkaClientId: bruno-kafka
  kafkaSslEnabled: true
  kafkaSslRejectUnauthorized: true
  kafkaCertsDir: C:/certs/dev
  kafkaTruststore: truststore-corporativo.jks
  kafkaKeystore:
  kafkaKeystore_pagamentos: pagamentos-dev.jks
  kafkaSaslEnabled: true
  kafkaSaslMechanism: scram-sha-512
  kafkaSaslUsername: svc-default-dev
  kafkaSaslUsername_pagamentos: svc-pagamentos-dev
  kafkaSchemaRegistryEnabled: true
  kafkaSchemaRegistryUrl: https://schema-registry.dev.interno
  kafkaSchemaRegistryUsername: svc-registry-dev
  kafkaDryRun: false
}
vars:secret [
  kafkaTruststorePassword,
  kafkaKeystorePassword_pagamentos,
  kafkaSaslPassword,
  kafkaSaslPassword_pagamentos,
  kafkaSchemaRegistryPassword
]
