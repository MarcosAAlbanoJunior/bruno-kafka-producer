meta {
  name: Send Kafka Message
  type: http
  seq: 1
}

post {
  url: {{kafkaEchoUrl}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "orderId": "12345",
    "status": "created"
  }
}

script:pre-request {
  const fs = require('fs');
  const path = require('path');
  const { sendKafkaMessage } = require(path.join(bru.cwd(), 'lib', 'kafka-producer.js'));

  // O JSON que voce editar na aba "Body" acima e o valor que sera publicado no topico
  // (crua ou codificada via Schema Registry, dependendo de kafkaSchemaRegistryEnabled).
  const messageValue = req.getBody();

  // Schema Registry e OPCIONAL. Se ativado, o schema a usar vem, em ordem de
  // prioridade: id explicito > arquivo .avsc/.json local (registra/reaproveita) >
  // ultimo schema publicado no subject.
  const schemaRegistryEnabled = bru.getEnvVar('kafkaSchemaRegistryEnabled') === 'true';
  let schemaRegistryConfig;
  if (schemaRegistryEnabled) {
    const schemaFile = bru.getEnvVar('kafkaValueSchemaFile');
    const schemaId = bru.getEnvVar('kafkaValueSchemaId');

    schemaRegistryConfig = {
      enabled: true,
      url: bru.getEnvVar('kafkaSchemaRegistryUrl'),
      auth: bru.getEnvVar('kafkaSchemaRegistryUsername') ? {
        username: bru.getEnvVar('kafkaSchemaRegistryUsername'),
        password: process.env.KAFKA_SCHEMA_REGISTRY_PASSWORD || undefined,
      } : undefined,
      value: {
        id: schemaId || undefined,
        type: bru.getEnvVar('kafkaValueSchemaType') || 'AVRO',
        subject: bru.getEnvVar('kafkaValueSchemaSubject') || undefined,
        schema: (!schemaId && schemaFile)
          ? fs.readFileSync(path.join(bru.cwd(), schemaFile), 'utf-8')
          : undefined,
      },
    };
  }

  const config = {
    brokers: bru.getEnvVar('kafkaBrokers').split(',').map((b) => b.trim()),
    clientId: bru.getEnvVar('kafkaClientId'),
    topic: bru.getEnvVar('kafkaTopic'),
    ssl: {
      enabled: bru.getEnvVar('kafkaSslEnabled') === 'true',
      rejectUnauthorized: bru.getEnvVar('kafkaSslRejectUnauthorized') !== 'false',
      // Truststore e Keystore sao OPCIONAIS - so entram em jogo se o caminho
      // estiver preenchido no environment selecionado.
      truststore: {
        path: bru.getEnvVar('kafkaTruststorePath') || undefined,
        password: process.env.KAFKA_TRUSTSTORE_PASSWORD || undefined,
      },
      keystore: {
        path: bru.getEnvVar('kafkaKeystorePath') || undefined,
        password: process.env.KAFKA_KEYSTORE_PASSWORD || undefined,
      },
    },
    sasl: {
      enabled: bru.getEnvVar('kafkaSaslEnabled') === 'true',
      mechanism: bru.getEnvVar('kafkaSaslMechanism'),
      username: bru.getEnvVar('kafkaSaslUsername'),
      password: process.env.KAFKA_SASL_PASSWORD || undefined,
    },
    schemaRegistry: schemaRegistryConfig,
  };

  try {
    const result = await sendKafkaMessage({
      ...config,
      key: bru.getVar('kafkaMessageKey'),
      value: messageValue,
    });

    bru.setVar('kafkaSendStatus', 'success');
    bru.setVar('kafkaSendResult', JSON.stringify(result));
    console.log('Kafka OK ->', result);

    // Este request HTTP so existe porque o Bruno sempre dispara uma chamada real
    // ao clicar em "Send" fora do Runner (bru.runner.skipRequest() so funciona
    // dentro do Collection Runner / bru CLI). Aproveitamos essa chamada "boba"
    // para ecoar o resultado do Kafka de volta na aba Response, so por conveniencia.
    req.setBody({ kafka: { status: 'success', result }, originalMessage: messageValue });
  } catch (err) {
    bru.setVar('kafkaSendStatus', 'error');
    bru.setVar('kafkaSendResult', err.message);
    console.error('Kafka FALHOU ->', err.message);
    req.setBody({ kafka: { status: 'error', error: err.message } });
  }
}

tests {
  test("Mensagem publicada no Kafka com sucesso", function () {
    expect(bru.getVar('kafkaSendStatus')).to.equal('success');
  });
}

docs {
  # Send Kafka Message

  O metodo/URL acima (POST para `kafkaEchoUrl`) e so um "veiculo": o trabalho de
  verdade acontece no **script:pre-request**, que chama o helper reutilizavel
  `lib/kafka-producer.js` (`sendKafkaMessage`) e publica no Kafka de verdade.

  Por que existe uma chamada HTTP no meio? Porque o Bruno sempre envia a
  requisicao HTTP configurada quando voce clica em "Send" fora do Collection
  Runner - nao existe um jeito de "so rodar o script". Entao deixamos essa
  chamada apontando para um echo (ou para qualquer endpoint interno inofensivo
  que voces tenham) so para visualizar o resultado do Kafka na aba Response.

  Se voce rodar essa collection via `bru run` (Bruno CLI) dentro de um pipeline,
  ai sim da pra usar `bru.runner.skipRequest()` no fim do script para pular o
  HTTP de verdade.

  ## Antes de usar
  1. `npm install` na raiz da collection (instala `kafkajs` e `jks-js`).
  2. Habilite o **Developer Mode** no Bruno (icone do escudo, canto superior
     direito) - e obrigatorio para o `require()` de pacotes npm funcionar.
  3. Copie `.env.sample` para `.env` e preencha as senhas.
  4. Escolha o environment (ex: `local`) e ajuste `kafkaBrokers`, `kafkaTopic`,
     `kafkaTruststorePath` / `kafkaKeystorePath` (deixe em branco se nao usar).
  5. Se o cluster usar Schema Registry, ative `kafkaSchemaRegistryEnabled` e ajuste
     `kafkaSchemaRegistryUrl` / `kafkaValueSchemaFile` (ou `...SchemaId`/`...SchemaSubject`)
     - veja detalhes no README.md.
  6. Edite o JSON da aba Body - e ele que vai como valor da mensagem Kafka (com ou
     sem Schema Registry, o Body continua sendo o mesmo JSON).
}
